{
  "name": "core",
  "private": true,
  "version": "0.0.0",
  "description": "Zero-knowledge password, secret and .env manager",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @core/web dev",
    "build": "pnpm --filter @core/web build",
    "start": "pnpm --filter @core/web start",
    "typecheck": "tsc --build && pnpm --filter @core/web exec tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "playwright codegen http://localhost:3000",
    "e2e:install": "playwright install --with-deps chromium",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "d1": "wrangler d1",
    "cf": "wrangler",
    "db:generate": "pnpm --filter @core/db generate",
    "db:migrate:local": "wrangler d1 migrations apply core-vault --local",
    "db:migrate": "wrangler d1 migrations apply core-vault --remote",
    "db:studio": "wrangler d1 execute core-vault --local --command",
    "cf:types": "wrangler types apps/web/cloudflare-env.d.ts --include-runtime=false",
    "db:seed": "tsx scripts/seed-dev.mts"
  },
  "devDependencies": {
    "@core/crypto": "workspace:*",
    "@core/shared": "workspace:*",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}

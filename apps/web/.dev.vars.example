# Copy to .dev.vars and fill in. Wrangler loads .dev.vars automatically when
# running locally; it is git-ignored.
#
# Generate a pepper:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Use a DIFFERENT value here from the one in production. Local accounts are
# throwaway; the production pepper is not.

AUTH_PEPPER=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — only needed for the features that use them.
RESEND_API_KEY=
# A domain you control and have verified with Resend. Not the domain the app is
# served from unless you have verified that one too — an unverified sender is
# accepted by Resend and then dropped or filed as spam by the receiver, which
# looks like the email never being sent.
RESEND_FROM_EMAIL="Core <no-reply@mail.example.com>"
# Leave this empty locally.
#
# With a secret key set, every request without a Turnstile token is refused —
# which is every request the test suite makes, because an API-level test cannot
# solve a challenge. Turnstile itself is covered by unit tests in
# `lib/server/turnstile.test.ts`; the browser suite runs with it off, and
# production has it on.
#
# To see the widget while developing, set only the *site* key in
# `apps/web/.env.local` and leave this blank: the server allows everything when
# it has no secret, so the widget renders and nothing is refused.
TURNSTILE_SECRET_KEY=
# The site key is NOT set here. It is public and inlined at build time, so Next
# reads it from `.env.local` rather than from this file, which Wrangler reads
# for the Worker's own bindings. Setting it here does nothing and looks like it
# should work:
#     apps/web/.env.local
#     NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...


# Rate limiting: name the caller with a header instead of the connection.
#
# Locally, workerd sets `cf-connecting-ip` itself, so the limiter is fully live
# and every test in the suite shares one address — three signups per ten
# minutes, and the fourth test fails along with the four hundred after it.
#
# With this set, the limiter takes its caller from the `x-core-caller` header
# and does not limit a request that omits it. That gives each test its own
# bucket and leaves the rest of the suite alone.
#
# Never set this in production. There, the header is not read at all.
RATE_LIMIT_TEST_MODE=1

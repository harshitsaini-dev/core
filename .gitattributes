* text=auto eol=lf

# Windows shells want CRLF. cmd.exe in particular can mishandle `goto` labels
# in a LF-only batch file, so these must not be normalised with everything else.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.wasm binary

pnpm-lock.yaml linguist-generated=true -diff

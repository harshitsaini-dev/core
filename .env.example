# ---------------------------------------------------------------------------
# Core — environment variables
#
# Copy to .dev.vars for local Wrangler development. Never commit real values.
# Production secrets are set with:  pnpm dlx wrangler secret put <NAME>
# ---------------------------------------------------------------------------

# REQUIRED. Random 32 bytes, base64. Mixed into auth verifiers only; it plays
# no part in data encryption, so losing it cannot expose a vault - but it will
# permanently lock every existing account out of logging in. Back it up.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_PEPPER=

# REQUIRED. Canonical URL of your instance. Used in emails and the manifest.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL. Login alerts and magic-link unlocks. Without it, Core still works.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Core <no-reply@kernel.harshitsaini.in>"

# OPTIONAL. Bot protection on the auth endpoints.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
